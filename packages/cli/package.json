{
  "name": "@weft/cli",
  "version": "0.0.0",
  "description": "Command-line interface for Weft design directories",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "weft": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/main.js', 0o755)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@weft/bridge": "workspace:*",
    "@weft/core": "workspace:*",
    "@weft/design-io": "workspace:*",
    "@weft/export": "workspace:*",
    "@weft/extract": "workspace:*",
    "@weft/mcp": "workspace:*",
    "@weft/workspace": "workspace:*"
  }
}
