{
  "name": "@weft/workspace",
  "version": "0.0.0",
  "description": "Local Weft workspace registry and project/design discovery",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
