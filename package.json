{
  "name": "weft",
  "version": "0.0.0",
  "private": true,
  "description": "Agent-native design canvas for the browser",
  "license": "MIT",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r build && pnpm -r typecheck",
    "test": "pnpm -r build && pnpm -r test",
    "weft": "node packages/cli/dist/main.js",
    "verify": "pnpm build && pnpm typecheck && pnpm test && pnpm weft validate examples/starter.weft && pnpm weft fmt examples/starter.weft --check",
    "audit": "pnpm audit --audit-level high"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
